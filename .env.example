APP_BUILD_CONTEXT=.
APP_PORT=8080
SERVER_PORT=8080

SPRING_DOCKER_COMPOSE_ENABLED=true
SPRING_JPA_HIBERNATE_DDL_AUTO=update

MYSQL_IMAGE=mysql:8.4
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_INTERNAL_PORT=3306
MYSQL_DATABASE=maeul
MYSQL_USER=maeul
MYSQL_PASSWORD=maeul
MYSQL_ROOT_PASSWORD=root
MYSQL_CREATE_DATABASE_IF_NOT_EXIST=true
MYSQL_USE_SSL=false
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
MYSQL_VOLUME_NAME=mysql-data
MYSQL_HEALTHCHECK_INTERVAL=10s
MYSQL_HEALTHCHECK_TIMEOUT=5s
MYSQL_HEALTHCHECK_RETRIES=10
MYSQL_HEALTHCHECK_START_PERIOD=20s

REDIS_IMAGE=redis:7.4-alpine
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_INTERNAL_PORT=6379
REDIS_HEALTHCHECK_INTERVAL=10s
REDIS_HEALTHCHECK_TIMEOUT=5s
REDIS_HEALTHCHECK_RETRIES=10

TZ=Asia/Seoul

JWT_SECRET_KEY=

# 공공데이터포털 API KEY
OPEN_API_SECRET_KEY=

# 앱 설치 페이지(/app) 스토어 링크. 비어 있으면 준비 중
APP_STORE_ANDROID_URL=
APP_STORE_IOS_URL=

# 사진 미션 기준 사진을 내려받을 호스트(쉼표 구분, https). 비어 있으면 사진 미션을 제출할 수 없음
PHOTO_MISSION_ALLOWED_IMAGE_HOSTS=
