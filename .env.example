APP_BUILD_CONTEXT=.
APP_PORT=8080
SERVER_PORT=8080

SPRING_DOCKER_COMPOSE_ENABLED=false
SPRING_JPA_HIBERNATE_DDL_AUTO=update

MYSQL_IMAGE=mysql:8.4
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_INTERNAL_PORT=3306
MYSQL_DATABASE=maeul
MYSQL_USER=maeul
MYSQL_PASSWORD=maeul
MYSQL_ROOT_PASSWORD=root
MYSQL_CREATE_DATABASE_IF_NOT_EXIST=true
MYSQL_USE_SSL=false
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
MYSQL_VOLUME_NAME=mysql-data
MYSQL_HEALTHCHECK_INTERVAL=10s
MYSQL_HEALTHCHECK_TIMEOUT=5s
MYSQL_HEALTHCHECK_RETRIES=10
MYSQL_HEALTHCHECK_START_PERIOD=20s

REDIS_IMAGE=redis:7.4-alpine
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_INTERNAL_PORT=6379
REDIS_HEALTHCHECK_INTERVAL=10s
REDIS_HEALTHCHECK_TIMEOUT=5s
REDIS_HEALTHCHECK_RETRIES=10

TZ=Asia/Seoul
