### 위치 기록 임시 데이터 업로드 (지금 기준 지난 3시간: 머문 장소 2곳 + 그 사이 이동)
# 1분 간격으로 만든다. 수집 주기(기본 1분)보다 촘촘한 기록과 미래 시각 기록은 서버가 저장하지 않는다.
# 이미 저장된 시각과 겹치는 기록은 건너뛴다(응답의 skipped). 다시 보내면 지금까지 지난 분만 새로 저장된다.
< {%
    // 시나리오: [위도, 경도, 분] - 머문 장소는 반경 100m 안에서 조금씩 흔들리고, 이동은 두 장소 사이를 직선으로 잇는다
    const stayA = {lat: 35.1468, lng: 126.9200, minutes: 60};  // 광주 동구 국립아시아문화전당
    const moveMinutes = 30;
    const stayB = {lat: 35.1466, lng: 126.8411, minutes: 90};  // 광주 서구 김대중컨벤션센터

    const intervalMs = 60 * 1000;
    const total = stayA.minutes + moveMinutes + stayB.minutes;
    const end = Math.floor(Date.now() / intervalMs) * intervalMs - intervalMs;
    const start = end - (total - 1) * intervalMs;

    // 한국 시간(+09:00) ISO-8601 문자열
    function kst(ms) {
        return new Date(ms + 9 * 60 * 60 * 1000).toISOString().substring(0, 19) + "+09:00";
    }

    // 약 20m 안에서 흔들기
    function jitter(i) {
        return 0.0002 * Math.sin(i * 1.7);
    }

    const points = [];
    for (let i = 0; i < total; i++) {
        let lat, lng;
        if (i < stayA.minutes) {
            lat = stayA.lat + jitter(i);
            lng = stayA.lng + jitter(i + 3);
        } else if (i < stayA.minutes + moveMinutes) {
            const t = (i - stayA.minutes + 1) / (moveMinutes + 1);
            lat = stayA.lat + (stayB.lat - stayA.lat) * t;
            lng = stayA.lng + (stayB.lng - stayA.lng) * t;
        } else {
            lat = stayB.lat + jitter(i);
            lng = stayB.lng + jitter(i + 3);
        }
        points.push({
            latitude: Number(lat.toFixed(6)),
            longitude: Number(lng.toFixed(6)),
            accuracy: 10,
            recordedAt: kst(start + i * intervalMs)
        });
    }

    request.variables.set("timelinePoints", JSON.stringify(points));
    client.global.set("timelineDate", kst(end).substring(0, 10));
%}
POST {{server-url}}/api/timeline/points
Authorization: Bearer {{access-token}}
Content-Type: application/json

{
  "points": {{timelinePoints}}
}

> {%
    client.test("위치 기록 저장", function () {
        client.assert(response.status === 200, "응답 코드: " + response.status);
    });
%}

### 위치 기록 임시 데이터 업로드 (고정 예시 3건)
POST {{server-url}}/api/timeline/points
Authorization: Bearer {{access-token}}
Content-Type: application/json

{
  "points": [
    {"latitude": 35.146800, "longitude": 126.920000, "accuracy": 10, "recordedAt": "2026-11-14T09:00:00+09:00"},
    {"latitude": 35.146850, "longitude": 126.920050, "accuracy": 10, "recordedAt": "2026-11-14T09:01:00+09:00"},
    {"latitude": 35.146780, "longitude": 126.919980, "accuracy": 10, "recordedAt": "2026-11-14T09:02:00+09:00"}
  ]
}

### 하루 타임라인 확인 (위 업로드한 날짜)
GET {{server-url}}/api/timeline?date={{timelineDate}}
Authorization: Bearer {{access-token}}
